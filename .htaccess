<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # API Routing Fallbacks
    RewriteRule ^api/kopken/outlets/?$ api/outlets.php [QSA,L]
    RewriteRule ^api/kopken/menu/([^/]+)/?$ api/menu.php?outlet=$1 [QSA,L]
    RewriteRule ^api/kopken/menu/?$ api/menu.php [QSA,L]
    RewriteRule ^api/kopken/track/([^/]+)/?$ api/track.php?code=$1 [QSA,L]
    RewriteRule ^api/kopken/track/?$ api/track.php [QSA,L]
    RewriteRule ^api/kopken/order/?$ api/order.php [QSA,L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# UTF-8 Encoding default
AddDefaultCharset UTF-8
