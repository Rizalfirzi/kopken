{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": "config.php,index.php,includes/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/api/kopken/outlets/?",
      "dest": "/api/outlets.php"
    },
    {
      "src": "/api/kopken/item/?",
      "dest": "/api/item.php"
    },
    {
      "src": "/api/kopken/wifi/?",
      "dest": "/api/wifi.php"
    },
    {
      "src": "/api/kopken/menu/([^/]+)/?",
      "dest": "/api/menu.php?outlet=$1"
    },
    {
      "src": "/api/kopken/menu/?",
      "dest": "/api/menu.php"
    },
    {
      "src": "/api/kopken/track/([^/]+)/?",
      "dest": "/api/track.php?code=$1"
    },
    {
      "src": "/api/kopken/track/?",
      "dest": "/api/track.php"
    },
    {
      "src": "/api/kopken/order/?",
      "dest": "/api/order.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
